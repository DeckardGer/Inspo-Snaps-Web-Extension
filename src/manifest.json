{
	"{{chrome}}.manifest_version": 3,
	"{{firefox}}.manifest_version": 2,
	"permissions": ["storage", "activeTab", "contextMenus", "cookies"],
	"host_permissions": ["<all_urls>"],
	"{{chrome}}.externally_connectable": {
		"matches": ["http://localhost:3000/*", "https://insposnaps.com/*"]
	},
	"icons": {
		"16": "icon/16.png",
		"32": "icon/32.png",
		"48": "icon/48.png",
		"96": "icon/96.png",
		"128": "icon/128.png"
	},
	"{{chrome}}.action": {
		"default_icon": {
			"16": "icon/16.png",
			"32": "icon/32.png",
			"48": "icon/48.png",
			"96": "icon/96.png",
			"128": "icon/128.png"
		},
		"default_title": "Inspo Snaps"
	},
	"{{firefox}}.browser_action": {
		"default_icon": {
			"16": "icon/16.png",
			"32": "icon/32.png",
			"48": "icon/48.png",
			"96": "icon/96.png",
			"128": "icon/128.png"
		},
		"default_title": "Inspo Snaps"
	},
	"background": {
		"{{chrome}}.service_worker": "src/background/index.ts",
		"{{firefox}}.scripts": ["src/background/index.ts"]
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["src/content/index.tsx"],
			"run_at": "document_idle"
		}
	],
	"{{chrome}}.web_accessible_resources": [
		{
			"resources": ["fonts/*"],
			"matches": ["<all_urls>"]
		}
	],
	"{{firefox}}.web_accessible_resources": ["fonts/*"]
}
