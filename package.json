{
	"name": "inspo-snaps-extension",
	"private": true,
	"version": "1.0.0",
	"description": "Save, organise, and share your visual inspiration. Capture images from any webpage and curate them in your inspiration library.",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build"
	},
	"dependencies": {
		"@hugeicons/core-free-icons": "^3.1.1",
		"@hugeicons/react": "^1.1.4",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tooltip": "^1.2.8",
		"@tailwindcss/vite": "^4.1.17",
		"@tanstack/hotkeys": "^0.4.0",
		"@tanstack/react-hotkeys": "^0.4.0",
		"better-auth": "^1.4.9",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"embla-carousel-react": "^8.6.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"tailwind-merge": "^3.4.0",
		"tailwindcss": "^4.1.17",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/react": "^18.0.26",
		"@types/react-dom": "^18.0.9",
		"@types/webextension-polyfill": "^0.10.0",
		"@vitejs/plugin-react-swc": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "~5.6.3",
		"vite": "^5.0.0",
		"vite-plugin-web-extension": "^4.0.0",
		"webextension-polyfill": "^0.10.0"
	},
	"manifest": {
		"host_permissions": [
			"http://localhost:3000",
			"https://insposnaps.com"
		]
	}
}
